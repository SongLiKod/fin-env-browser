{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "FinEnv 管理面板最小权限：仅允许窗口核心能力与本地文件对话框，禁止前端直接访问文件系统、Shell 与 HTTP。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
